@model MinimarketApp.Models.Categoria

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <!-- TARJETA FLOTANTE -->
        <div class="card shadow-lg border-0 rounded-3 overflow-hidden mt-4">
            <!-- Encabezado Azul -->
            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);">
                <h4 class="fw-bold m-0">✨ Registrar Nueva Categoría</h4>
            </div>

            <div class="card-body p-5">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- NOMBRE -->
                    <div class="form-floating mb-3">
                        <input asp-for="Nombre" class="form-control rounded-pill" placeholder="Nombre" />
                        <label asp-for="Nombre" class="ps-4">Nombre de la Categoría</label>
                        <span asp-validation-for="Nombre" class="text-danger ps-3 small"></span>
                    </div>

                    <!-- DESCRIPCIÓN -->
                    <div class="form-floating mb-4">
                        <input asp-for="Descripcion" class="form-control rounded-pill" placeholder="Descripción" />
                        <label asp-for="Descripcion" class="ps-4">Descripción Breve</label>
                        <span asp-validation-for="Descripcion" class="text-danger ps-3 small"></span>
                    </div>

                    <!-- BOTONES -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm" style="background: #2575fc; border:none;">
                            💾 Guardar Categoría
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill border-0">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}