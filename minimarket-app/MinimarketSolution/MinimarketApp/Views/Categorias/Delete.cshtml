@model MinimarketApp.Models.Categoria

@{
    ViewData["Title"] = "Eliminar";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Cabecera Roja de Peligro -->
            <div class="card-header bg-danger text-white text-center py-3">
                <h4 class="fw-bold m-0">⚠️ Eliminar Categoría</h4>
            </div>

            <div class="card-body p-5 text-center">
                <h3 class="text-dark fw-bold mb-3">¿Estás seguro?</h3>
                <p class="text-muted mb-4">
                    Vas a eliminar la categoría <strong>"@Html.DisplayFor(model => model.Nombre)"</strong>.
                    <br>Esta acción no se puede deshacer.
                </p>

                <div class="alert alert-warning text-start rounded-3">
                    <small><strong>Nota:</strong> Asegúrate de que no haya productos asignados a esta categoría antes de borrarla.</small>
                </div>

                <dl class="row text-start mt-4 bg-light p-3 rounded-3">
                    <dt class="col-sm-4">Nombre:</dt>
                    <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Nombre)</dd>

                    <dt class="col-sm-4">Descripción:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="IdCategoria" />
                    <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 shadow-sm">
                        🗑 Sí, Eliminar
                    </button>
                    <div class="mt-3">
                        <a asp-action="Index" class="text-decoration-none text-secondary">Cancelar y Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>