@model MinimarketApp.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card shadow-lg border-0 rounded-3 overflow-hidden mt-4">
            <!-- Encabezado Naranja (Para diferenciar Editar) -->
            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #ff9966 0%, #ff5e62 100%);">
                <h4 class="fw-bold m-0">✏️ Editar Categoría</h4>
            </div>

            <div class="card-body p-5">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="IdCategoria" />

                    <div class="form-floating mb-3">
                        <input asp-for="Nombre" class="form-control rounded-pill" placeholder="Nombre" />
                        <label asp-for="Nombre" class="ps-4">Nombre</label>
                        <span asp-validation-for="Nombre" class="text-danger ps-3 small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Descripcion" class="form-control rounded-pill" placeholder="Descripción" />
                        <label asp-for="Descripcion" class="ps-4">Descripción</label>
                        <span asp-validation-for="Descripcion" class="text-danger ps-3 small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm border-0" style="background: #ff5e62;">
                            💾 Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill border-0">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}