@{
    ViewData["Title"] = "Panel Principal";
}

<div class="text-center mb-5">
    <h1 class="display-4">Bienvenido al Sistema Minimarket</h1>
    <p class="lead text-muted">Selecciona un módulo para comenzar a trabajar.</p>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-primary">
            <div class="card-header bg-primary text-white">
                <h4 class="my-0 font-weight-normal">📦 Catálogo</h4>
            </div>
            <div class="card-body text-center">
                <p class="card-text">Gestiona los productos y cómo se agrupan.</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-primary btn-lg">
                        Ver Categorías
                    </a>
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-primary btn-lg">
                        Ver Productos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-success">
            <div class="card-header bg-success text-white">
                <h4 class="my-0 font-weight-normal">🚚 Almacén</h4>
            </div>
            <div class="card-body text-center">
                <p class="card-text">Control de proveedores y entrada de stock.</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Proveedores" asp-action="Index" class="btn btn-outline-success btn-lg">
                        Proveedores
                    </a>
                    <a asp-controller="Lotes" asp-action="Index" class="btn btn-success btn-lg">
                        Entrada Mercadería
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-secondary">
            <div class="card-header bg-secondary text-white">
                <h4 class="my-0 font-weight-normal">💰 Caja (POS)</h4>
            </div>
            <div class="card-body text-center">
                <p class="card-text">Módulo de ventas y facturación.</p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-secondary btn-lg" disabled>
                        Ir a la Caja
                    </button>
                    <small class="text-muted mt-2">(Próximamente)</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="alert alert-info text-center">
            <strong>📌 Nota:</strong> Recuerda revisar el <a asp-controller="Lotes" asp-action="Index" class="alert-link">Semáforo de Vencimientos</a> todos los días al iniciar turno.
        </div>
    </div>
</div>