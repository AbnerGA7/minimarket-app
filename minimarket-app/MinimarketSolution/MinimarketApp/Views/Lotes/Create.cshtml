@model MinimarketApp.Models.Lote

@{
    ViewData["Title"] = "Registrar Ingreso";
}

<h1>Registrar Ingreso de Mercadería</h1>
<hr />

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <!-- COLUMNA 1: QUÉ COMPRAMOS -->
                        <div class="col-md-6">
                            <h5 class="text-muted border-bottom pb-2">📦 Datos del Producto</h5>

                            <div class="form-group mb-3">
                                <label asp-for="IdProveedor" class="control-label fw-bold">1. Proveedor</label>
                                <select asp-for="IdProveedor" class="form-select" asp-items="ViewBag.IdProveedor">
                                    <option value="">-- Seleccione --</option>
                                </select>
                                <span asp-validation-for="IdProveedor" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="IdProducto" class="control-label fw-bold">2. Producto</label>
                                <select asp-for="IdProducto" class="form-select" asp-items="ViewBag.IdProducto">
                                    <option value="">-- Seleccione --</option>
                                </select>
                                <span asp-validation-for="IdProducto" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="NumeroLote" class="control-label fw-bold">3. N° Lote / Código</label>
                                <input asp-for="NumeroLote" class="form-control" placeholder="Ej: L-2025-A" />
                                <span asp-validation-for="NumeroLote" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="FechaVencimiento" class="control-label fw-bold text-danger">4. Vencimiento</label>
                                <input asp-for="FechaVencimiento" class="form-control border-danger" type="date" />
                                <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- COLUMNA 2: CUÁNTO COSTÓ (AUTOMATIZADO) -->
                        <div class="col-md-6 bg-light p-3 rounded">
                            <h5 class="text-primary border-bottom pb-2">💰 Costos y Cantidades</h5>

                            <!-- PASO A: CANTIDAD -->
                            <div class="form-group mb-3">
                                <label asp-for="CantidadInicial" class="control-label fw-bold">A. Cantidad Recibida</label>
                                <input asp-for="CantidadInicial" id="txtCantidad" class="form-control form-control-lg" type="number" placeholder="0" min="1" />
                                <span asp-validation-for="CantidadInicial" class="text-danger"></span>
                            </div>

                            <!-- PASO B: COSTO TOTAL (NO SE GUARDA, SOLO AYUDA) -->
                            <div class="form-group mb-3">
                                <label class="control-label fw-bold text-primary">B. Costo Total del Lote (S/)</label>
                                <div class="input-group">
                                    <span class="input-group-text">S/</span>
                                    <input type="number" id="txtCostoTotal" class="form-control" placeholder="Total pagado por todo" step="0.01" />
                                </div>
                                <small class="text-muted">Ingrese cuánto pagó en total por estas unidades.</small>
                            </div>

                            <!-- PASO C: COSTO UNITARIO (CALCULADO) -->
                            <div class="form-group mb-3">
                                <label asp-for="CostoCompraUnitario" class="control-label fw-bold text-success">C. Costo Unitario (Calculado)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-success text-white">S/</span>
                                    <!-- readonly para que no lo modifiquen manual, solo cálculo -->
                                    <input asp-for="CostoCompraUnitario" id="txtCostoUnitario" class="form-control fw-bold text-success bg-white" type="number" step="0.0001" readonly />
                                </div>
                                <span asp-validation-for="CostoCompraUnitario" class="text-danger"></span>
                                <small class="text-muted">Resultado de (Total / Cantidad)</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">💾 Guardar Ingreso al Almacén</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // AUTOMATIZACIÓN DE CÁLCULO
        const txtCantidad = document.getElementById("txtCantidad");
        const txtCostoTotal = document.getElementById("txtCostoTotal");
        const txtCostoUnitario = document.getElementById("txtCostoUnitario");

        function calcularUnitario() {
            const cantidad = parseFloat(txtCantidad.value) || 0;
            const total = parseFloat(txtCostoTotal.value) || 0;

            if (cantidad > 0 && total > 0) {
                // Calculamos con hasta 4 decimales para precisión
                const unitario = total / cantidad;
                txtCostoUnitario.value = unitario.toFixed(2);

                // Visualmente mostramos si es válido
                txtCostoUnitario.classList.remove("is-invalid");
                txtCostoUnitario.classList.add("is-valid");
            } else {
                txtCostoUnitario.value = "";
                txtCostoUnitario.classList.remove("is-valid");
            }
        }

        // Escuchamos cuando el usuario escribe en cualquiera de los dos campos
        txtCantidad.addEventListener("input", calcularUnitario);
        txtCostoTotal.addEventListener("input", calcularUnitario);
    </script>
}