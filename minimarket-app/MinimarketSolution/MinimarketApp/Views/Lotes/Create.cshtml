@model MinimarketApp.Models.Lote

@{
    ViewData["Title"] = "Registrar Ingreso";
}

<h1>Registrar Ingreso de Mercadería</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="IdProducto" class="control-label">Producto</label>
                <select asp-for="IdProducto" class="form-control" asp-items="ViewBag.IdProducto">
                    <option value="">-- Seleccione un Producto --</option>
                </select>
                <span asp-validation-for="IdProducto" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdProveedor" class="control-label">Proveedor</label>
                <select asp-for="IdProveedor" class="form-control" asp-items="ViewBag.IdProveedor">
                    <option value="">-- Seleccione un Proveedor --</option>
                </select>
                <span asp-validation-for="IdProveedor" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NumeroLote" class="control-label">N° Lote (Código en la caja)</label>
                <input asp-for="NumeroLote" class="form-control" placeholder="Ej: L-2025-XA" />
                <span asp-validation-for="NumeroLote" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FechaVencimiento" class="control-label">Fecha de Vencimiento</label>
                <input asp-for="FechaVencimiento" class="form-control" type="date" />
                <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CostoCompraUnitario" class="control-label">Costo de Compra (Unitario)</label>
                <input asp-for="CostoCompraUnitario" class="form-control" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="CostoCompraUnitario" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CantidadInicial" class="control-label">Cantidad Recibida</label>
                <input asp-for="CantidadInicial" class="form-control" type="number" placeholder="Ej: 50" />
                <span asp-validation-for="CantidadInicial" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Registrar Ingreso" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}