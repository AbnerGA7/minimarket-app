@model MinimarketApp.Models.Lote

@{
    ViewData["Title"] = "Eliminar Lote";
}

<h1 class="text-danger">Dar de Baja Lote</h1>

<h3>¿Estás seguro de que deseas eliminar este registro?</h3>
<div class="alert alert-warning border-warning">
    <strong>⚠️ Advertencia Crítica:</strong>
    <br />
    Al eliminar este lote, el <strong>Stock Actual (@Model.StockActual unidades)</strong> desaparecerá del inventario inmediatamente.
    <br />
    <small>Solo elimínalo si fue un error de registro. Si el producto se rompió o venció, considera usar el módulo de Mermas (si está implementado).</small>
</div>

<div class="container mt-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="m-0">Datos del Lote a Eliminar</h5>
        </div>
        <div class="card-body">
            <dl class="row">

                <!-- PRODUCTO -->
                <dt class="col-sm-3 text-muted">Producto</dt>
                <dd class="col-sm-9 fw-bold fs-5">
                    @Html.DisplayFor(model => model.IdProductoNavigation.Nombre)
                </dd>

                <!-- PROVEEDOR -->
                <dt class="col-sm-3 text-muted">Proveedor</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.IdProveedorNavigation.RazonSocial)
                </dd>

                <!-- N° LOTE -->
                <dt class="col-sm-3 text-muted">N° Lote</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NumeroLote)
                </dd>

                <hr class="my-3" />

                <!-- FECHAS -->
                <dt class="col-sm-3 text-muted">Fecha Vencimiento</dt>
                <dd class="col-sm-9 text-danger fw-bold">
                    @Model.FechaVencimiento.ToShortDateString()
                </dd>

                <dt class="col-sm-3 text-muted">Fecha Recepción</dt>
                <dd class="col-sm-9">
                    @Model.FechaRecepcion?.ToString("dd/MM/yyyy")
                </dd>

                <!-- COSTOS -->
                <dt class="col-sm-3 text-muted">Costo Unitario</dt>
                <dd class="col-sm-9">
                    S/ @Model.CostoCompraUnitario.ToString("N2")
                </dd>

                <!-- STOCK -->
                <dt class="col-sm-3 text-muted">Stock Actual</dt>
                <dd class="col-sm-9 fw-bold">
                    @Html.DisplayFor(model => model.StockActual) Unidades
                </dd>

                <!-- ESTADO -->
                <dt class="col-sm-3 text-muted">Estado</dt>
                <dd class="col-sm-9">
                    @(Model.Estado ? "Activo" : "Inactivo")
                </dd>
            </dl>
        </div>
        <div class="card-footer text-end">
            <form asp-action="Delete">
                <input type="hidden" asp-for="IdLote" />
                <a asp-action="Index" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-danger">🗑 Confirmar Baja</button>
            </form>
        </div>
    </div>
</div>