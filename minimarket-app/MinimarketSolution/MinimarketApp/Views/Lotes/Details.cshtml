@model MinimarketApp.Models.Lote

@{
    ViewData["Title"] = "Detalles del Lote";
}

<h1>📄 Detalles del Ingreso de Mercadería</h1>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="m-0">Información del Lote #@Model.NumeroLote</h5>
        </div>
        <div class="card-body">
            <dl class="row">

                <!-- SECCIÓN 1: DATOS DEL PRODUCTO -->
                <dt class="col-sm-3 text-muted">Producto</dt>
                <dd class="col-sm-9 fw-bold fs-5">
                    @Html.DisplayFor(model => model.IdProductoNavigation.Nombre)
                </dd>

                <dt class="col-sm-3 text-muted">Proveedor</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.IdProveedorNavigation.RazonSocial)
                </dd>

                <dt class="col-sm-3 text-muted">Código de Lote</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.NumeroLote)
                </dd>

                <hr class="my-3" />

                <!-- SECCIÓN 2: FECHAS -->
                <dt class="col-sm-3 text-muted">Fecha de Recepción</dt>
                <dd class="col-sm-9">
                    @Model.FechaRecepcion?.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-3 text-muted">Fecha de Vencimiento</dt>
                <dd class="col-sm-9 text-danger fw-bold">
                    @Model.FechaVencimiento.ToShortDateString()
                </dd>

                <hr class="my-3" />

                <!-- SECCIÓN 3: COSTOS Y STOCK -->
                <dt class="col-sm-3 text-muted">Costo Unitario Compra</dt>
                <dd class="col-sm-9 text-success">
                    S/ @Model.CostoCompraUnitario.ToString("N2")
                </dd>

                <dt class="col-sm-3 text-muted">Cantidad Inicial</dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.CantidadInicial) Unidades
                </dd>

                <dt class="col-sm-3 text-muted">Stock Actual</dt>
                <dd class="col-sm-9 fw-bold" style="font-size: 1.2em;">
                    @Html.DisplayFor(model => model.StockActual) Unidades
                </dd>

                <dt class="col-sm-3 text-muted">Estado</dt>
                <dd class="col-sm-9">
                    @if (Model.Estado)
                    {
                        <span class="badge bg-success">Activo / Disponible</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo / Agotado</span>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer text-end">
            <a asp-action="Edit" asp-route-id="@Model?.IdLote" class="btn btn-primary">✏️ Editar</a>
            <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
        </div>
    </div>
</div>