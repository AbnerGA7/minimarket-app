@model MinimarketApp.Models.Lote

@{
    ViewData["Title"] = "Editar Lote";
}

<h1>Editar Lote (Mercadería)</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="IdLote" />

            <div class="form-group mb-3">
                <label asp-for="IdProducto" class="control-label">Producto</label>
                <select asp-for="IdProducto" class="form-control" asp-items="ViewBag.IdProducto">
                    <option value="">-- Seleccione Producto --</option>
                </select>
                <span asp-validation-for="IdProducto" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdProveedor" class="control-label">Proveedor</label>
                <select asp-for="IdProveedor" class="form-control" asp-items="ViewBag.IdProveedor">
                    <option value="">-- Seleccione Proveedor --</option>
                </select>
                <span asp-validation-for="IdProveedor" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NumeroLote" class="control-label">N° Lote (Código caja)</label>
                <input asp-for="NumeroLote" class="form-control" />
                <span asp-validation-for="NumeroLote" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="FechaVencimiento" class="control-label">Fecha Vencimiento</label>
                    <input asp-for="FechaVencimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="FechaRecepcion" class="control-label">Fecha Recepción</label>
                    <input asp-for="FechaRecepcion" class="form-control" type="date" />
                    <span asp-validation-for="FechaRecepcion" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CostoCompraUnitario" class="control-label">Costo Compra (Unitario)</label>
                <input asp-for="CostoCompraUnitario" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="CostoCompraUnitario" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="CantidadInicial" class="control-label">Cantidad Original</label>
                    <input asp-for="CantidadInicial" class="form-control" readonly />
                    <span asp-validation-for="CantidadInicial" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="StockActual" class="control-label">Stock Actual (Ajuste)</label>
                    <input asp-for="StockActual" class="form-control" />
                    <span asp-validation-for="StockActual" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="Estado" id="checkEstado" />
                <label class="form-check-label" for="checkEstado">
                    ¿Lote Activo / Disponible?
                </label>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}