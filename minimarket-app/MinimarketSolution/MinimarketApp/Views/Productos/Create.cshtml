@model MinimarketApp.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<h1>Registrar Nuevo Producto</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Código de Barras</label>
                <input asp-for="CodigoBarras" class="form-control" placeholder="Escanea o escribe el código..." />
                <span asp-validation-for="CodigoBarras" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Nombre del Producto</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Coca Cola 600ml" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IdCategoria" class="control-label">Categoría</label>

                <select asp-for="IdCategoria" class="form-control" asp-items="ViewBag.IdCategoria">
                    <option value="">-- Seleccione una Categoría --</option>
                </select>

                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Stock Mínimo (Para Alerta)</label>
                <input asp-for="StockMinimo" class="form-control" value="5" />
                <span asp-validation-for="StockMinimo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Precio de Venta (S/)</label>
                <input asp-for="PrecioVenta" class="form-control" type="number" step="0.10" />
                <span asp-validation-for="PrecioVenta" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Unidad de Medida</label>
                <select asp-for="UnidadMedida" class="form-control">
                    <option value="UNIDAD">UNIDAD (Botella, Paquete, Lata)</option>
                    <option value="KG">KG (A granel, Peso)</option>
                </select>
                <span asp-validation-for="UnidadMedida" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar Producto" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}