@model MinimarketApp.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h1 class="text-danger">Eliminar Producto</h1>

<h3>¿Estás seguro de que quieres eliminar este producto?</h3>
<div class="alert alert-warning">
    <strong>Advertencia:</strong> Si eliminas este producto, el historial de ventas relacionado podría verse afectado.
</div>

<div>
    <h4>Datos del Producto</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Código Barras
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CodigoBarras)
        </dd>

        <dt class="col-sm-2">
            Nombre
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            Stock Mínimo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StockMinimo)
        </dd>

        <dt class="col-sm-2">
            Precio Venta
        </dt>
        <dd class="col-sm-10">
            S/ @Html.DisplayFor(model => model.PrecioVenta)
        </dd>

        <dt class="col-sm-2">
            Unidad
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UnidadMedida)
        </dd>

        <dt class="col-sm-2">
            Categoría
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdCategoriaNavigation.Nombre)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdProducto" />
        <input type="submit" value="Confirmar Eliminación" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>