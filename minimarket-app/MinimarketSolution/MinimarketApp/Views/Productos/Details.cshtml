@model MinimarketApp.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<h1>Detalles del Producto</h1>

<div>
    <h4>Información Registrada</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Código de Barras
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CodigoBarras)
        </dd>

        <dt class="col-sm-2">
            Nombre del Producto
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            Stock Mínimo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.StockMinimo)
        </dd>

        <dt class="col-sm-2">
            Precio de Venta
        </dt>
        <dd class="col-sm-10">
            S/ @Html.DisplayFor(model => model.PrecioVenta)
        </dd>

        <dt class="col-sm-2">
            Unidad de Medida
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UnidadMedida)
        </dd>

        <dt class="col-sm-2">
            Categoría
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdCategoriaNavigation.Nombre)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdProducto" class="btn btn-primary">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>