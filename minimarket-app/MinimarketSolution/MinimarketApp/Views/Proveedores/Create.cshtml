@model MinimarketApp.Models.Proveedore

@{
    ViewData["Title"] = "Registrar Proveedor";
}

<h1>Registrar Nuevo Proveedor</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="RucDni" class="control-label">RUC / DNI</label>
                <input asp-for="RucDni" class="form-control" placeholder="Ej: 20100055237" />
                <span asp-validation-for="RucDni" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="RazonSocial" class="control-label">Razón Social / Nombre</label>
                <input asp-for="RazonSocial" class="form-control" placeholder="Ej: Distribuidora Alicorp S.A." />
                <span asp-validation-for="RazonSocial" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Telefono" class="control-label">Teléfono</label>
                <input asp-for="Telefono" class="form-control" placeholder="Ej: 999-888-777" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Correo Electrónico</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="ventas@proveedor.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Direccion" class="control-label">Dirección</label>
                <input asp-for="Direccion" class="form-control" placeholder="Av. Principal 123, Lima" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Guardar Proveedor" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}