@model MinimarketApp.Models.Proveedore

@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<div class="row justify-content-center">
    <div class="col-md-8">

        <!-- TARJETA FLOTANTE -->
        <div class="card shadow-lg border-0 rounded-3 overflow-hidden mt-4">
            <!-- Encabezado Verde -->
            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #198754 0%, #38a56a 100%);">
                <h4 class="fw-bold m-0">🚛 Registrar Nuevo Proveedor</h4>
            </div>

            <div class="card-body p-5">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <!-- RUC/DNI y Razon Social -->
                        <div class="col-md-6 form-floating mb-3">
                            <input asp-for="RucDni" class="form-control rounded-pill" placeholder="RUC / DNI" />
                            <label asp-for="RucDni" class="ps-4">RUC / DNI</label>
                            <span asp-validation-for="RucDni" class="text-danger ps-3 small"></span>
                        </div>
                        <div class="col-md-6 form-floating mb-3">
                            <input asp-for="RazonSocial" class="form-control rounded-pill" placeholder="Razón Social" />
                            <label asp-for="RazonSocial" class="ps-4">Razón Social</label>
                            <span asp-validation-for="RazonSocial" class="text-danger ps-3 small"></span>
                        </div>

                        <!-- Teléfono y Email -->
                        <div class="col-md-6 form-floating mb-3">
                            <input asp-for="Telefono" class="form-control rounded-pill" placeholder="Teléfono" />
                            <label asp-for="Telefono" class="ps-4">Teléfono</label>
                            <span asp-validation-for="Telefono" class="text-danger ps-3 small"></span>
                        </div>
                        <div class="col-md-6 form-floating mb-3">
                            <input asp-for="Email" class="form-control rounded-pill" placeholder="Correo Electrónico" />
                            <label asp-for="Email" class="ps-4">Correo Electrónico</label>
                            <span asp-validation-for="Email" class="text-danger ps-3 small"></span>
                        </div>

                        <!-- Dirección -->
                        <div class="col-12 form-floating mb-4">
                            <input asp-for="Direccion" class="form-control rounded-pill" placeholder="Dirección" />
                            <label asp-for="Direccion" class="ps-4">Dirección</label>
                            <span asp-validation-for="Direccion" class="text-danger ps-3 small"></span>
                        </div>
                    </div>

                    <!-- BOTONES -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success btn-lg rounded-pill shadow-sm" style="border:none;">
                            💾 Guardar Proveedor
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill border-0">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}