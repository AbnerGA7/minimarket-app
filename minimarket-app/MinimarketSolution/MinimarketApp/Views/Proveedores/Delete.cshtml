@model MinimarketApp.Models.Proveedore

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Cabecera Roja de Peligro -->
            <div class="card-header bg-danger text-white text-center py-3">
                <h4 class="fw-bold m-0">⚠️ Eliminar Proveedor</h4>
            </div>

            <div class="card-body p-5 text-center">
                <h3 class="text-dark fw-bold mb-3">¿Estás seguro?</h3>
                <p class="text-muted mb-4">
                    Vas a eliminar a <strong>@Html.DisplayFor(model => model.RazonSocial)</strong>.
                    <br>Esto no se puede deshacer y puede afectar el historial de lotes.
                </p>

                <div class="alert alert-warning text-start rounded-3">
                    <small><strong>Advertencia:</strong> Los lotes asociados quedarán sin referencia de proveedor.</small>
                </div>

                <div class="bg-light p-3 rounded-3 text-start mt-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">RUC/DNI:</span>
                        <strong>@Html.DisplayFor(model => model.RucDni)</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Teléfono:</span>
                        <strong>@Html.DisplayFor(model => model.Telefono)</strong>
                    </div>
                </div>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="IdProveedor" />
                    <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 shadow-sm">
                        🗑 Sí, Eliminar
                    </button>
                    <div class="mt-3">
                        <a asp-action="Index" class="text-decoration-none text-secondary">Cancelar y Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>