@model IEnumerable<MinimarketApp.Models.Proveedore>

@{
    ViewData["Title"] = "Proveedores";
}

<style>
    .page-header-green {
        background: linear-gradient(135deg, #198754 0%, #38a56a 100%);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 1.5rem;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .btn-custom {
        border-radius: 50px;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        padding: 0.5rem 1.2rem;
    }

    .table-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    .table thead {
        background-color: #f8f9fa;
        color: #495057;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }
</style>

<!-- ENCABEZADO -->
<div class="page-header-green d-flex justify-content-between align-items-center">
    <div>
        <h1 class="fw-bold mb-0">🚚 Directorio de Proveedores</h1>
        <p class="mb-0 opacity-75">Administra a quién le compras la mercadería</p>
    </div>
    <a asp-action="Create" class="btn btn-light text-success fw-bold rounded-pill shadow-sm px-4">
        + Nuevo Proveedor
    </a>
</div>

<!-- TABLA -->
<div class="card table-card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4 py-3">RUC / DNI</th>
                    <th class="py-3">Razón Social</th>
                    <th class="py-3">Teléfono</th>
                    <th class="py-3">Dirección</th>
                    <th class="text-end pe-4 py-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold">
                            @Html.DisplayFor(modelItem => item.RucDni)
                        </td>
                        <td class="fw-bold text-success">
                            @Html.DisplayFor(modelItem => item.RazonSocial)
                        </td>
                        <td class="text-muted">
                            @Html.DisplayFor(modelItem => item.Telefono)
                        </td>
                        <td class="text-muted">
                            @Html.DisplayFor(modelItem => item.Direccion)
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.IdProveedor" class="btn btn-outline-primary btn-sm rounded-start-pill" title="Editar">
                                    ✏️
                                </a>
                                <a asp-action="Details" asp-route-id="@item.IdProveedor" class="btn btn-outline-info btn-sm" title="Detalles">
                                    ℹ️
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.IdProveedor" class="btn btn-outline-danger btn-sm rounded-end-pill" title="Eliminar">
                                    🗑
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>