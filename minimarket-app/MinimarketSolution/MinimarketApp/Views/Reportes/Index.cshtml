@model IEnumerable<MinimarketApp.Models.Venta>

@{
    ViewData["Title"] = "Reporte de Ganancias";

    decimal vendido = ViewBag.TotalVendido;
    decimal costo = ViewBag.TotalCosto;
    decimal ganancia = ViewBag.GananciaNeta;
    decimal margen = vendido > 0 ? (ganancia / vendido) * 100 : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📈 Reporte de Ventas y Ganancias</h1>
    <button onclick="window.print()" class="btn btn-secondary no-print">🖨 Imprimir en Papel</button>
</div>

<!-- SECCIÓN DE FILTROS Y EXPORTACIÓN -->
<div class="card shadow-sm mb-4 no-print border-primary">
    <div class="card-header bg-primary text-white">
        <h6 class="m-0">Filtrar por Rango de Fechas</h6>
    </div>
    <div class="card-body bg-light">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha Inicio</label>
                <!-- El valor viene del ViewBag para mantener la selección -->
                <input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha Fin</label>
                <input type="date" name="fechaFin" value="@ViewBag.FechaFin" class="form-control" />
            </div>
            <div class="col-md-3">
                <!-- Botón para VER en pantalla (llama al Index) -->
                <button type="submit" asp-action="Index" class="btn btn-primary w-100">
                    🔍 Filtrar Resultados
                </button>
            </div>
            <div class="col-md-3">
                <!-- Botón para DESCARGAR (llama a ExportarExcel con las mismas fechas) -->
                <button type="submit" asp-action="ExportarExcel" class="btn btn-success w-100">
                    📊 Descargar Excel
                </button>
            </div>
        </form>
    </div>
</div>

<!-- TARJETAS DE RESUMEN (KPIs) -->
<div class="row mb-4 text-center">
    <!-- 1. VENTAS -->
    <div class="col-md-4">
        <div class="card text-white bg-primary shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Ingresos Totales (Ventas)</h5>
                <h2 class="display-6 fw-bold">S/ @vendido.ToString("N2")</h2>
                <small>Dinero bruto que entró a caja</small>
            </div>
        </div>
    </div>
    <!-- 2. COSTOS -->
    <div class="col-md-4">
        <div class="card text-white bg-danger shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Costo de Mercadería</h5>
                <h2 class="display-6 fw-bold">S/ @costo.ToString("N2")</h2>
                <small>Valor de los productos entregados</small>
            </div>
        </div>
    </div>
    <!-- 3. GANANCIA -->
    <div class="col-md-4">
        <div class="card text-white bg-success shadow h-100">
            <div class="card-body">
                <h5 class="card-title">Utilidad Neta (Ganancia)</h5>
                <h2 class="display-6 fw-bold">S/ @ganancia.ToString("N2")</h2>
                <small>Margen de rentabilidad: @margen.ToString("0.0")%</small>
            </div>
        </div>
    </div>
</div>

<!-- TABLA DETALLADA DE OPERACIONES -->
<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="m-0">Detalle de Operaciones</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0 align-middle" style="font-size: 0.9rem;">
            <thead class="table-dark">
                <tr>
                    <th>Ticket</th>
                    <th>Fecha</th>
                    <th>Cajero</th> <!-- COLUMNA AÑADIDA -->
                    <th class="text-center">Items</th>
                    <th class="text-end" title="Monto cobrado al cliente">Total Venta</th>
                    <th class="text-end" title="Costo promedio por unidad en esta venta">Costo Unit.</th>
                    <th class="text-end" title="Costo total de la mercadería vendida">Costo Total</th>
                    <th class="text-end">Utilidad</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <h4>📭 No se encontraron ventas</h4>
                            <p>Intenta cambiar los filtros de búsqueda.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        // Lógica de cálculo por fila
                        decimal costoVentaTotal = item.DetalleVenta.Sum(d => d.Cantidad * (d.IdLoteNavigation?.CostoCompraUnitario ?? 0));
                        decimal utilidadVenta = item.TotalVenta - costoVentaTotal;
                        int cantidadItems = item.DetalleVenta.Sum(d => d.Cantidad);
                        decimal costoProm = cantidadItems > 0 ? costoVentaTotal / cantidadItems : 0;

                        <tr>
                            <td class="fw-bold">
                                <a asp-controller="Ventas" asp-action="Details" asp-route-id="@item.IdVenta" class="text-decoration-none">
                                    #@item.IdVenta.ToString("D6")
                                </a>
                            </td>
                            <td>@item.FechaVenta?.ToString("dd/MM/yy HH:mm")</td>

                            <!-- NOMBRE DEL CAJERO (Auditoría) -->
                            <td>
                                @(item.IdUsuarioNavigation?.NombreCompleto ?? "N/A")
                            </td>

                            <td class="text-center">@cantidadItems</td>

                            <td class="text-end text-primary fw-bold">S/ @item.TotalVenta.ToString("N2")</td>
                            <td class="text-end text-muted">S/ @costoProm.ToString("N2")</td>
                            <td class="text-end text-danger">S/ @costoVentaTotal.ToString("N2")</td>
                            <td class="text-end text-success fw-bold">S/ @utilidadVenta.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        .card {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
        }

        .bg-primary, .bg-danger, .bg-success {
            color: black !important;
            background-color: white !important;
            border: 1px solid #000;
            -webkit-print-color-adjust: exact;
        }

        body {
            -webkit-print-color-adjust: exact;
        }
    }
</style>