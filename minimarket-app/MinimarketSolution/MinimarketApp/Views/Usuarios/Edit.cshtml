@model MinimarketApp.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}

<h1>✏️ Editar Datos del Empleado</h1>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="IdUsuario" />
                    <input type="hidden" asp-for="Activo" /> <!-- Mantenemos el estado original -->
                    <!-- NOMBRE -->
                    <div class="form-group mb-3">
                        <label asp-for="NombreCompleto" class="control-label fw-bold">Nombre Completo</label>
                        <input asp-for="NombreCompleto" class="form-control" />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>

                    <!-- USUARIO -->
                    <div class="form-group mb-3">
                        <label asp-for="Username" class="control-label fw-bold">Usuario (Login)</label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <!-- ROL -->
                    <div class="form-group mb-3">
                        <label asp-for="IdRol" class="control-label fw-bold">Rol / Cargo</label>
                        <select asp-for="IdRol" class="form-select" asp-items="ViewBag.IdRol"></select>
                        <span asp-validation-for="IdRol" class="text-danger"></span>
                    </div>

                    <!-- CONTRASEÑA (Opcional cambiarla) -->
                    <div class="alert alert-info py-2 mt-3">
                        <small>ℹ️ Si no deseas cambiar la clave, deja la actual escrita o escribe una nueva.</small>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="PasswordHash" class="control-label fw-bold">Contraseña</label>
                        <input asp-for="PasswordHash" class="form-control" type="text" /> <!-- Type text para verla y editarla fácil -->
                        <span asp-validation-for="PasswordHash" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">💾 Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}