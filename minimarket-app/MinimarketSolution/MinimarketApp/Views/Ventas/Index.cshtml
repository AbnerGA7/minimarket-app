@model IEnumerable<MinimarketApp.Models.Venta>

@{
    ViewData["Title"] = "Historial de Ventas";
}

<!-- ENCABEZADO -->
<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        <h1 class="fw-bold mb-0">📜 Historial de Ventas</h1>
        <p class="mb-0 opacity-75 text-muted">Revisa transacciones y gestiona anulaciones.</p>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="NuevaVenta" class="btn btn-success btn-lg shadow rounded-pill">
            🛒 Ir a Caja (POS)
        </a>
    </div>
</div>

<!-- BUSCADOR DE TICKETS -->
<div class="card shadow-sm mb-4 border-info">
    <div class="card-body bg-light">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-bold">Buscar Ticket #:</label>
            </div>
            <div class="col-auto">
                <input type="number" name="buscarTicket" class="form-control rounded-pill" placeholder="Ej: 102" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary rounded-pill">🔍 Buscar</button>
            </div>
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Ver Todos</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">N° Ticket</th>
                    <th>Fecha y Hora</th>
                    <th>Medio de Pago</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <em>No se encontraron ventas registradas con ese criterio.</em>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary">
                                # @item.IdVenta.ToString("D6")
                            </td>
                            <td>
                                @item.FechaVenta?.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge bg-info text-dark border border-info rounded-pill">
                                    @Html.DisplayFor(modelItem => item.IdMedioPagoNavigation.Nombre)
                                </span>
                            </td>
                            <td class="text-end fw-bold text-success" style="font-size: 1.1em;">
                                S/ @item.TotalVenta.ToString("N2")
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.IdVenta" class="btn btn-primary btn-sm rounded-pill px-3">
                                    📄 Ver Ticket
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>