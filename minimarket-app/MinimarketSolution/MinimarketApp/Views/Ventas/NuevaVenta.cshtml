@model List<MinimarketApp.Models.CarritoItem>

@{
    ViewData["Title"] = "Punto de Venta";
    decimal totalVenta = Model.Sum(x => x.SubTotal);
    // Convertimos el total a string puro para que JavaScript no tenga problemas con comas/puntos decimales
    string totalVentaJs = totalVenta.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // Seguridad extra: Si el controlador no asignó ViewBag.ProductosJson, lo inicializamos como array vacío
    string productosJsonSeguro = ViewBag.ProductosJson as string ?? "[]";
}

<div class="container-fluid">
    <div class="row">

        <!-- SECCIÓN IZQUIERDA: BUSCADOR Y CARRITO -->
        <div class="col-md-8">

            <!-- 1. BUSCADOR INTELIGENTE -->
            <div class="card shadow-sm mb-3 border-primary">
                <div class="card-body p-3">
                    <h5 class="fw-bold mb-2 text-primary">🔍 Búsqueda Rápida</h5>
                    <div class="row g-2">
                        <div class="col-md-10">
                            <!-- ESTE ES EL CAMPO PARA EL LECTOR O TECLADO -->
                            <input type="text" id="txtBuscar" class="form-control form-control-lg rounded-pill" placeholder="Escanea código o escribe nombre..." autofocus autocomplete="off" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-secondary w-100 btn-lg rounded-pill" onclick="limpiarBuscador()">Limpiar</button>
                        </div>
                    </div>

                    <!-- RESULTADOS DE BÚSQUEDA (Se llena con JS) -->
                    <div id="divResultados" class="list-group mt-2 shadow" style="display:none; position: absolute; z-index: 1000; width: 70%;">
                        <!-- Aquí aparecerán las opciones -->
                    </div>
                </div>
            </div>

            <!-- FORMULARIOS OCULTOS (Para acciones POST) -->
            <form id="formAgregar" asp-action="AgregarProducto" method="post" style="display:none;">
                <input type="hidden" name="idProducto" id="hfIdProducto" />
                <!-- Cantidad se envía como string para soportar decimales (granel) -->
                <input type="hidden" name="cantidadStr" value="1" id="hfCantidad" />
            </form>

            <form id="formActualizarPrecio" asp-action="ActualizarPrecioItem" method="post" style="display:none;">
                <input type="hidden" name="idProducto" id="hfIdProductoPrecio" />
                <input type="hidden" name="nuevoPrecio" id="hfNuevoPrecio" />
            </form>

            <!-- 3. TABLA DEL CARRITO -->
            <div class="card shadow-sm border-secondary" style="min-height: 400px;">
                <div class="card-header bg-secondary text-white py-2">
                    <h5 class="m-0" style="font-size: 1rem;">Detalle de Venta</h5>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Unidad</th>
                                <th class="text-center">Precio</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">SubTotal</th>
                                <th class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <h3 class="display-6">🛒</h3>
                                        <p>Escanea o busca un producto para empezar la venta.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    // Lógica para mostrar la cantidad correctamente formateada
                                    string unidad = item.UnidadMedida == "KG" ? "Kg" : "Und.";
                                    string cantidadStr = (item.UnidadMedida == "KG") ? item.Cantidad.ToString("0.###") : item.Cantidad.ToString("0");

                                    <tr>
                                        <td>
                                            <span class="fw-bold">@item.NombreProducto</span>
                                        </td>
                                        <td class="text-center small text-muted">@unidad</td>
                                        <td class="text-center">
                                            <!-- PRECIO CON BOTÓN DE LÁPIZ -->
                                            <div class="d-flex justify-content-center align-items-center">
                                                <span class="me-2 fw-bold text-success">S/ @item.PrecioUnitario.ToString("N2")</span>

                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-circle" style="width: 30px; height: 30px; padding: 0;"
                                                        onclick="abrirModalPrecio(@item.IdProducto, '@item.PrecioUnitario.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)')"
                                                        title="Editar Precio/Descuento">
                                                    ✎
                                                </button>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <!-- BOTONES DE CANTIDAD -->
                                            <div class="btn-group btn-group-sm">
                                                <!-- Llama a disminuir cantidad (resta 1 o 0.1KG) -->
                                                <a asp-action="DisminuirCantidad" asp-route-idProducto="@item.IdProducto" class="btn btn-outline-secondary text-dark fw-bold">-</a>
                                                <button type="button" class="btn btn-outline-dark disabled" style="width: 45px; background:white; color:black; border-color:#ccc; opacity:1;">
                                                    @cantidadStr
                                                </button>
                                                <!-- Llama a agregar rápido (+1 o +0.1KG si fuera el caso, pero aquí solo suma 1 por defecto) -->
                                                <button type="button" class="btn btn-outline-secondary text-dark fw-bold" onclick="agregarRapido(@item.IdProducto)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold">S/ @item.SubTotal.ToString("N2")</td>
                                        <td class="text-center">
                                            <a asp-action="QuitarProducto" asp-route-idProducto="@item.IdProducto" class="btn btn-sm btn-danger text-white rounded-circle" title="Quitar item">×</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: TOTALES Y PAGO -->
        <div class="col-md-4">
            <div class="card shadow border-success h-100">
                <div class="card-body d-flex flex-column justify-content-between">

                    <div>
                        <h6 class="text-muted text-uppercase">Total a Pagar</h6>
                        <h1 class="display-3 fw-bold text-success text-center my-4">
                            S/ @totalVenta.ToString("N2")
                        </h1>
                        <hr />

                        <!-- BOTONES DE ACCESO RÁPIDO (HISTORIAL Y GASTOS) -->
                        <div class="d-grid gap-2 mb-3">
                            <a asp-action="Index" asp-controller="Ventas" class="btn btn-outline-info quick-access-btn rounded-pill">
                                📜 Mi Historial de Ventas
                            </a>
                            <a asp-action="Movimiento" asp-controller="Caja" asp-route-tipo="RETIRO" class="btn btn-outline-danger quick-access-btn rounded-pill">
                                ➖ Registrar Gasto/Retiro
                            </a>
                        </div>

                        <form asp-action="ConfirmarVenta" method="post" id="formPago">

                            <!-- MEDIO DE PAGO -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Medio de Pago</label>
                                <select name="IdMedioPago" class="form-select form-select-lg rounded-pill" asp-items="ViewBag.IdMedioPago"></select>
                            </div>

                            <!-- DINERO RECIBIDO -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Recibido (S/)</label>
                                <input type="number" id="txtMontoPagado" name="MontoPagado" class="form-control form-control-lg text-center fs-3 rounded-pill border-primary" step="0.10" required />
                            </div>

                            <!-- CÁLCULO DE VUELTO (Visual) -->
                            <div class="alert alert-warning text-center py-2 shadow-sm">
                                <small>Vuelto</small><br />
                                <span id="lblVuelto" class="fs-3 fw-bold">S/ 0.00</span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg py-3 rounded-pill" @(Model == null || Model.Count == 0 ? "disabled" : "")>
                                    ✅ COBRAR Y EMITIR TICKET
                                </button>

                                <a asp-action="CancelarVenta" class="btn btn-outline-danger rounded-pill">
                                    🗑 Cancelar Venta
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL BONITO PARA EDITAR PRECIO -->
<div class="modal fade" id="modalEditarPrecio" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalLabel">✏️ Editar Precio Unitario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <input type="hidden" id="hfIdProductoModal" />
                <label class="form-label text-muted">Nuevo Precio (S/)</label>
                <input type="number" id="txtNuevoPrecioModal" class="form-control form-control-lg text-center fw-bold text-primary" step="0.01" autofocus />
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success px-4" onclick="confirmarCambioPrecio()">Guardar</button>
            </div>
        </div>
    </div>
</div>


<!-- JAVASCRIPT PARA LA LÓGICA DEL POS -->
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script>
        // 1. INYECCIÓN DEL JSON DE PRODUCTOS (Corregida la inyección)
        const productosData = @Html.Raw(productosJsonSeguro);

        // Referencias Globales
        const txtBuscar = document.getElementById("txtBuscar");
        const divResultados = document.getElementById("divResultados");
        // Inicialización del modal de Bootstrap
        var modalPrecio = new bootstrap.Modal(document.getElementById('modalEditarPrecio'));
        let timeout = null;

        // 2. EVENTO AL ESCRIBIR (BÚSQUEDA)
        if(txtBuscar) {
            txtBuscar.addEventListener("keyup", function (e) {
                // Si presiona ENTER (Lector de Barras), intenta agregar el primer resultado
                if (e.key === "Enter") {
                    if (divResultados.children.length === 1) {
                        divResultados.children[0].click();
                    } else if (divResultados.children.length === 0) {
                         // Si no encuentra, busca por texto puro (asumiendo que es código de barras exacto)
                         const codigoExacto = productosData.find(p => p.codigoBarras.toLowerCase() === txtBuscar.value.toLowerCase());
                         if (codigoExacto) {
                             seleccionarProducto(codigoExacto.idProducto);
                         }
                    }
                    return;
                }

                clearTimeout(timeout);
                timeout = setTimeout(() => {
                    const term = txtBuscar.value;
                    if (term.length < 2) {
                        divResultados.style.display = "none";
                        return;
                    }
                    buscarProducto(term);
                }, 300); // Esperamos 300ms para no saturar
            });
        }

        // 3. FUNCIÓN AJAX PARA BUSCAR
        function buscarProducto(term) {
            // Usamos el JSON cargado en la vista (más rápido que una llamada AJAX al controlador)
            const resultados = productosData.filter(p =>
                p.nombre.toLowerCase().includes(term.toLowerCase()) ||
                p.codigoBarras.toLowerCase().includes(term.toLowerCase())
            );

            divResultados.innerHTML = "";
            if (resultados.length === 0) {
                divResultados.style.display = "none";
                return;
            }

            resultados.forEach(p => {
                // Lógica de Stock Total
                // Note: El stock real ahora viene del controlador en el JSON
                let stockHtml = p.stockTotal > 0
                    ? `<span class="badge bg-success rounded-pill">${p.stockTotal} ${p.unidadMedida}</span>`
                    : `<span class="badge bg-danger rounded-pill">Agotado</span>`;

                const item = document.createElement("a");
                item.className = "list-group-item list-group-item-action d-flex justify-content-between align-items-center";
                item.innerHTML = `
                    <div>
                        <div class="fw-bold">${p.nombre}</div>
                        <small class="text-muted">Cod: ${p.codigoBarras}</small> -
                        <span class="text-primary fw-bold">S/ ${p.precioVenta.toFixed(2)}</span>
                    </div>
                    ${stockHtml}
                `;

                if(p.stockTotal > 0) {
                    item.style.cursor = "pointer";
                    item.onclick = () => seleccionarProducto(p.idProducto);
                } else {
                    item.classList.add("disabled");
                }

                divResultados.appendChild(item);
            });
            divResultados.style.display = "block";
        }

        // 4. SELECCIONAR Y ENVIAR AL CARRITO
        function seleccionarProducto(id) {
            document.getElementById("hfIdProducto").value = id;

            // La cantidad se envía por defecto como '1'.
            document.getElementById("hfCantidad").value = 1;

            // Limpiar y enviar
            limpiarBuscador();
            document.getElementById("formAgregar").submit();
        }

        // 5. AGREGAR RÁPIDO (+1) DESDE LA TABLA
        function agregarRapido(id) {
            document.getElementById("hfIdProducto").value = id;
            document.getElementById("hfCantidad").value = 1;
            document.getElementById("formAgregar").submit();
        }

        function limpiarBuscador() {
            txtBuscar.value = "";
            divResultados.style.display = "none";
            txtBuscar.focus();
        }

        // 6. FUNCIONES DEL MODAL DE PRECIO
        function abrirModalPrecio(idProducto, precioActual) {
            document.getElementById("hfIdProductoModal").value = idProducto;
            document.getElementById("txtNuevoPrecioModal").value = precioActual;

            if(modalPrecio) {
                modalPrecio.show();
                // Foco en el input del modal y seleccionar texto
                setTimeout(() => {
                    const inputModal = document.getElementById("txtNuevoPrecioModal");
                    if(inputModal) {
                        inputModal.focus();
                        inputModal.select();
                    }
                }, 500);
            }
        }

        function confirmarCambioPrecio() {
            const id = document.getElementById("hfIdProductoModal").value;
            const precioStr = document.getElementById("txtNuevoPrecioModal").value;
            const precio = parseFloat(precioStr);

            if (!isNaN(precio) && precio >= 0) {
                document.getElementById("hfIdProductoPrecio").value = id;
                document.getElementById("hfNuevoPrecio").value = precio.toFixed(2);
                document.getElementById("formActualizarPrecio").submit();
            } else {
                alert("Ingrese un precio válido (mayor o igual a 0).");
            }
        }

        // Guardar con Enter en el modal
        document.getElementById("txtNuevoPrecioModal").addEventListener("keyup", function(e) {
            if (e.key === "Enter") {
                confirmarCambioPrecio();
            }
        });


        // 7. CÁLCULO DE VUELTO
        document.getElementById('txtMontoPagado').addEventListener('input', function () {
            var total = parseFloat('@totalVentaJs');
            var pagado = parseFloat(this.value) || 0;
            var vuelto = pagado - total;
            var label = document.getElementById('lblVuelto');

            if(vuelto < 0) {
                label.innerText = "Falta S/ " + Math.abs(vuelto).toFixed(2);
                label.classList.add("text-danger");
            } else {
                label.innerText = "S/ " + vuelto.toFixed(2);
                label.classList.remove("text-danger");
            }
        });

        // 8. Foco inicial para el POS
        window.onload = () => txtBuscar.focus();
    </script>
}